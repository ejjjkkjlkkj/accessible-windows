LAB11
role = self-hosted-machine-witness-record
system-foundation = false
purpose = replay the Lab10 relation and recovery invariants on the dedicated AMD-5800H-REAL self-hosted Windows runner
target-runner = AMD-5800H-REAL
target-runner-os = Windows
target-runner-arch = X64
target-cpu-match = 5800H
external-infrastructure = GitHub Actions runner Windows PowerShell CSharp compiler and host operating system
external-infrastructure-semantics = witness-only
growth-origin = inherited-from-lab10-external-distinction-pair
growth-rule = inherited-from-lab10-current-material-followed-by-global-label-exchange
widths = 2,4,8,16,32,64,128,256
serial-repeat-coverage = 2
parallel-worker-policy = one worker per reported logical processor
parallel-repeat-per-worker = 1
single-position-coverage = every position at every width on every witness execution
pair-position-coverage = every unordered pair at every width on every witness execution
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-cpu-identity = UNPROVEN
proof-serial = UNPROVEN
proof-parallel = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove that the Lab10 tested relation and recovery invariants are reproducible on the dedicated self-hosted AMD-5800H-REAL machine
claim = success would prove that repeated serial and externally scheduled parallel witness executions preserve the tested invariants
claim = success would not make Windows GitHub Actions PowerShell CSharp x86-64 or the AMD processor architecture part of the system foundation
claim = success would not establish system-owned truth bit byte word integer language instruction memory runtime process api model ui or accessibility semantics
