LAB12
role = external-machine-execution-witness-record
system-foundation = false
purpose = execute an exact raw machine-byte transition witness on AMD-5800H-REAL without assigning system semantics to the processor instruction set
target-runner = AMD-5800H-REAL
target-runner-os = Windows
target-runner-arch = X64
target-cpu-match = 5800H
raw-code-length = 17
raw-code-hex = 4885d2740b8031ff48ffc148ffca75f5c3
raw-code-sha256 = 6fc989173743c7a8365b35253d17c746da914c15aff357252d9a139557e5edd5
raw-code-effect = externally observed global exchange of the two Lab10 witness labels across a supplied finite carrier
widths = 2,4,8,16,32,64,128,256
serial-coverage = one full width sweep
parallel-worker-policy = one worker per reported logical processor
parallel-repeat-per-worker = 4
roundtrip-property = applying the exact raw machine bytes twice must recover the original external carrier
external-infrastructure = AMD x86-64 processor Windows virtual memory ABI PowerShell CSharp compiler GitHub Actions runner
external-infrastructure-semantics = witness-only
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-cpu-identity = UNPROVEN
proof-raw-execution = UNPROVEN
proof-parallel = UNPROVEN
proof-roundtrip = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove that one exact 17-byte external machine witness executes reproducibly on the dedicated AMD carrier
claim = success would prove the observed exchange and roundtrip properties across all Lab10 widths under serial and parallel external scheduling
claim = success would not make x86-64 Windows virtual memory CSharp PowerShell GitHub Actions or AMD architecture part of the system foundation
claim = success would not establish system-owned instruction language computation memory process api ui truth bit byte word integer or accessibility semantics
