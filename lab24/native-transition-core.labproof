LAB24
role = system-owned-native-transition-core-v1
system-foundation = true
depends-on = LAB21 native relational core v1
native-state = one LAB21 relational element
native-transition = compose current native state with one LAB21 relational action
native-ordering-rule = final semantic state depends on composition of submitted actions and not external scheduling order
external-concurrency-mechanism = Windows .NET Interlocked CompareExchange and scheduler
external-concurrency-semantics = witness-only
truth-semantics = none
boolean-semantics = none
integer-semantics = none
address-semantics = none
memory-semantics = none
process-semantics = none
target-real-runner = AMD-5800H-REAL
parallel-workers = 16
rounds = 64
operations-per-worker = 2000
expected-total-transitions = 2048000
independent-observer = GitHub-hosted Linux exhaustive sequential collapse check
external-infrastructure = AMD x86-64 Windows Linux GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = witness-only
proof = PENDING
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = transition semantics belong to the system and are defined only through LAB21 composition
claim = the external CAS implementation is a witness carrier and is not the system atomic or memory model
