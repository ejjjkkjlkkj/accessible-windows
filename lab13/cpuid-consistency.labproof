LAB13
role = external-processor-identity-witness-record
system-foundation = false
purpose = observe processor identity through the runtime CPUID intrinsic on AMD-5800H-REAL and test repeated parallel consistency
target-runner = AMD-5800H-REAL
target-runner-os = Windows
target-runner-arch = X64
expected-vendor = AuthenticAMD
expected-brand-substring = 5800H
queries = basic-leaf-0 leaf-1 extended-max extended-brand-2-through-4
parallel-worker-policy = one worker per reported logical processor
parallel-repeat-per-worker = 64
external-infrastructure = AMD x86-64 CPUID .NET runtime PowerShell CSharp compiler Windows GitHub Actions runner
external-infrastructure-semantics = witness-only
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-cpuid = UNPROVEN
proof-vendor = UNPROVEN
proof-brand = UNPROVEN
proof-parallel-consistency = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove repeated direct processor identity observations agree during the real AMD run
claim = success would not make CPUID x86-64 .NET Windows PowerShell CSharp GitHub Actions or AMD architecture part of the system foundation
claim = success would not establish system-owned identity instruction language computation memory time process api ui or accessibility semantics
