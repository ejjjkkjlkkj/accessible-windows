LAB22
role = external-explicit-affinity-and-cpuid-topology-witness-record
system-foundation = false
purpose = bind one external witness thread to every Windows logical processor on AMD-5800H-REAL and observe CPUID topology identity on that exact carrier
target-runner = AMD-5800H-REAL
expected-logical-processors = 16
affinity-policy = one dedicated witness thread per logical processor
cpuid-basic-identity = leaf-1 legacy APIC ID
cpuid-amd-topology = leaf-0x8000001E extended APIC ID core ID threads-per-core
external-infrastructure = AMD x86-64 CPUID Windows thread affinity Windows logical processor numbering .NET runtime PowerShell CSharp GitHub Actions runner
external-infrastructure-semantics = witness-only
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-process-affinity-mask = UNPROVEN
proof-affinity-all-logical-processors = UNPROVEN
proof-current-processor-matches-target = UNPROVEN
proof-legacy-apic-unique = UNPROVEN
proof-extended-apic-unique = UNPROVEN
proof-amd-topology-leaf = UNPROVEN
proof-accessibility-boundary = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove only the tested external mapping between Windows logical processor affinity and CPUID identities on this real AMD carrier
claim = success would not make Windows processor numbering affinity CPUID x86-64 or AMD topology semantics part of the system foundation
claim = success would not establish a system-owned scheduler processor topology thread model identity model or accessibility semantics
