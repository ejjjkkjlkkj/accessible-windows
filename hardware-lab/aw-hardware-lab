#!/usr/bin/env bash
set -euo pipefail

CONFIG_USB_BY_ID_FILE="/etc/accessible-windows/lab-usb-by-id"
DUT_BACKEND="/usr/local/sbin/aw-dut-cycle-test"

IMAGE=""
EXPECTED_SHA=""
SOURCE_RUN=""
COMMIT=""
RESULT_FILE=""

fail() {
  echo "AW_HARDWARE_LAB_FAIL: $*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image) IMAGE="${2:-}"; shift 2 ;;
    --sha256) EXPECTED_SHA="${2:-}"; shift 2 ;;
    --source-run) SOURCE_RUN="${2:-}"; shift 2 ;;
    --commit) COMMIT="${2:-}"; shift 2 ;;
    --result) RESULT_FILE="${2:-}"; shift 2 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

[[ "$(id -u)" -eq 0 ]] || fail "helper must run as root"
[[ -n "$IMAGE" && -f "$IMAGE" ]] || fail "missing image"
[[ "$EXPECTED_SHA" =~ ^[0-9a-fA-F]{64}$ ]] || fail "invalid expected SHA-256"
[[ -n "$SOURCE_RUN" ]] || fail "missing source run"
[[ "$COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || fail "invalid commit SHA"
[[ -n "$RESULT_FILE" ]] || fail "missing result path"
[[ -r "$CONFIG_USB_BY_ID_FILE" ]] || fail "missing $CONFIG_USB_BY_ID_FILE"
[[ -x "$DUT_BACKEND" ]] || fail "missing physical DUT backend $DUT_BACKEND"
[[ ! -w "$DUT_BACKEND" ]] || fail "DUT backend must not be writable"
[[ "$(stat -c '%U' "$DUT_BACKEND")" == "root" ]] || fail "DUT backend must be root-owned"

ACTUAL_SHA="$(sha256sum "$IMAGE" | awk '{print $1}')"
[[ "$ACTUAL_SHA" == "${EXPECTED_SHA,,}" ]] || fail "image SHA-256 mismatch"

USB_BY_ID="$(tr -d '\r\n' < "$CONFIG_USB_BY_ID_FILE")"
[[ "$USB_BY_ID" == /dev/disk/by-id/usb-* ]] || fail "configured device must be a /dev/disk/by-id/usb-* path"
[[ -L "$USB_BY_ID" ]] || fail "configured USB by-id symlink not found"
USB_DEVICE="$(readlink -f "$USB_BY_ID")"
[[ -b "$USB_DEVICE" ]] || fail "configured USB target is not a block device"

TYPE="$(lsblk -ndo TYPE "$USB_DEVICE" | head -n1)"
REMOVABLE="$(lsblk -ndo RM "$USB_DEVICE" | head -n1 | tr -d ' ')"
[[ "$TYPE" == "disk" ]] || fail "USB target must be a whole disk"
[[ "$REMOVABLE" == "1" ]] || fail "USB target is not marked removable"

ROOT_SOURCE="$(findmnt -n -o SOURCE / || true)"
ROOT_PARENT=""
if [[ -n "$ROOT_SOURCE" && -b "$ROOT_SOURCE" ]]; then
  ROOT_PARENT="/dev/$(lsblk -ndo PKNAME "$ROOT_SOURCE" 2>/dev/null | head -n1 || true)"
fi
[[ -z "$ROOT_PARENT" || "$USB_DEVICE" != "$ROOT_PARENT" ]] || fail "refusing to overwrite root filesystem disk"

if lsblk -nrpo MOUNTPOINT "$USB_DEVICE" | grep -qE '/.+'; then
  fail "USB target or one of its partitions is mounted"
fi

IMAGE_BYTES="$(stat -c '%s' "$IMAGE")"
DEVICE_BYTES="$(blockdev --getsize64 "$USB_DEVICE")"
(( DEVICE_BYTES >= IMAGE_BYTES )) || fail "USB device is smaller than image"

printf 'AW_HARDWARE_USB_PREFLIGHT_OK by_id=%s device=%s image_bytes=%s device_bytes=%s\n' \
  "$USB_BY_ID" "$USB_DEVICE" "$IMAGE_BYTES" "$DEVICE_BYTES"

# This write is intentionally only reachable after all immutable local checks.
dd if="$IMAGE" of="$USB_DEVICE" bs=16M iflag=fullblock conv=fsync status=progress
sync
blockdev --flushbufs "$USB_DEVICE"

cmp -n "$IMAGE_BYTES" "$IMAGE" "$USB_DEVICE" || fail "USB read-back verification failed"
echo "AW_HARDWARE_USB_READBACK_OK sha256=$ACTUAL_SHA"

BACKEND_RESULT="$(mktemp)"
trap 'rm -f "$BACKEND_RESULT"' EXIT

"$DUT_BACKEND" \
  --boot-device "$USB_BY_ID" \
  --image-sha256 "$ACTUAL_SHA" \
  --source-run "$SOURCE_RUN" \
  --commit "$COMMIT" \
  --result "$BACKEND_RESULT"

[[ -s "$BACKEND_RESULT" ]] || fail "DUT backend produced no evidence"
grep -Fqx "AW_PHYSICAL_BOOT_RESULT=PASS" "$BACKEND_RESULT" || fail "physical boot did not pass"
grep -Fqx "AW_INTERNAL_DISK_UNCHANGED=PASS" "$BACKEND_RESULT" || fail "internal disk integrity was not proven"
grep -Fqx "AW_NATIVE_KERNEL_ENTRY=PASS" "$BACKEND_RESULT" || fail "native kernel entry was not proven"

# Accessibility evidence is mandatory. A graphical boot alone can never make this lab PASS.
grep -Fqx "AW_KEYBOARD_RECOVERY=PASS" "$BACKEND_RESULT" || fail "keyboard recovery flow was not proven"
grep -Fqx "AW_STRUCTURED_DIAGNOSTICS=PASS" "$BACKEND_RESULT" || fail "structured diagnostics were not proven"
grep -Fqx "AW_ACCESSIBLE_RECOVERY_FLOW=PASS" "$BACKEND_RESULT" || fail "accessible recovery flow was not proven"
grep -Fqx "AW_NONVISUAL_ROLLBACK_FLOW=PASS" "$BACKEND_RESULT" || fail "nonvisual rollback flow was not proven"
NONVISUAL_CHANNEL="$(sed -n 's/^AW_NONVISUAL_CHANNEL=//p' "$BACKEND_RESULT" | tail -n1)"
case "$NONVISUAL_CHANNEL" in
  SPEECH|BRAILLE|SPEECH+BRAILLE) ;;
  *) fail "direct nonvisual output channel was not proven" ;;
esac

{
  echo "AW_PHYSICAL_BOOT_RESULT=PASS"
  echo "AW_INTERNAL_DISK_UNCHANGED=PASS"
  echo "AW_NATIVE_KERNEL_ENTRY=PASS"
  echo "AW_ACCESSIBILITY_HARDWARE_GATE=PASS"
  echo "AW_SOURCE_RUN=$SOURCE_RUN"
  echo "AW_COMMIT=$COMMIT"
  echo "AW_IMAGE_SHA256=$ACTUAL_SHA"
  echo "AW_USB_BY_ID=$USB_BY_ID"
  cat "$BACKEND_RESULT"
} | awk '!seen[$0]++' > "$RESULT_FILE"

chmod 0644 "$RESULT_FILE"
echo "AW_HARDWARE_LAB_PASS result=$RESULT_FILE"
