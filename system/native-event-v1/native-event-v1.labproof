NATIVE-EVENT-V1
role = system-owned-native-relational-event-delivery-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-LOCATION-V1
depends-on = NATIVE-STORE-V1
depends-on = NATIVE-SCHEDULER-V1
event-target = exact width-8 native relational location key
event-action = one native LAB21 relation element
delivery-rule = compose target cell state with event action exactly once
target-resolution = elementwise native location key equality
required-locations = 256
required-workers = 16
required-events-per-location = 32
required-submitted-events = 8192
required-delivered-events = 8192
exactly-once-delivery = required
canonical-replay-equivalence = required
external-delivery-order-semantics = none
numeric-event-id-semantics = none
interrupt-number-semantics = none
priority-semantics = none
deadline-semantics = none
source-identity-semantics = not-established
pointer-semantics = none
integer-address-semantics = none
external-event-index = witness-only
external-concurrency-mechanism = Windows .NET Parallel Interlocked CompareExchange
external-concurrency-semantics = carrier-and-witness-only
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux structural replay in forward and reverse external event order
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing event notification interrupt routing priority acknowledgement cancellation inspection or recovery surface must expose equivalent event target and action semantics nonvisually and remain fully operable without sight or pointer dependence
proof = PENDING
claim = success will establish system-owned exactly-once event delivery from a relational target key and relational action without numeric interrupt IDs integer addresses or pointers
claim = success will establish equivalence between concurrent AMD delivery and independent structural replay while assigning no semantics to external delivery order
claim = success will not establish event priority deadline source identity hardware interrupts interrupt masking acknowledgement or device semantics
