NATIVE-GOAL-EXECUTION-V1
role = system-owned-dynamic-goal-directed-cognition-action-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB24 native transition core v1
depends-on = NATIVE-COGNITION-V1
depends-on = NATIVE-ACTION-V1
depends-on = NATIVE-GOAL-V1
current-state = one native LAB21 relation element
goal-state = one human-selected native LAB21 relation element
action-derivation-rule = discover the unique native relation whose composition with current state yields the supplied goal
prediction-rule = compose current state with derived action
execution-rule = apply the same native transition composition
goal-verification-rule = predicted and actual state must equal the supplied native goal
autonomous-goal-selection = false
goal-source-authority = NATIVE-GOAL-V1 human selection
hardcoded-goal = none
external-planner = none
external-score = none
numeric-carrier-label-semantics = none
target-real-runner = AMD-5800H-REAL
required-state-goal-combinations = 4
independent-observer = GitHub-hosted Linux
external-infrastructure = AMD x86-64 Windows Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = carrier-and-witness-only
proof = PENDING
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing goal execution status prediction action confirmation failure or cancellation must expose the same native goal and action semantics nonvisually and remain operable without sight or pointer dependence
claim = success will establish that cognition and action can execute against either human-selected native goal rather than a fixed identity target
claim = success will cover all four current-state and goal-state combinations in the two-element native relation domain
claim = success will not establish arbitrary semantic planning long-horizon planning autonomous goal choice or external-world actuation
