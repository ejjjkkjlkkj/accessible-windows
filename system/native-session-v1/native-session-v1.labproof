NATIVE-SESSION-V1
role = system-owned-accessible-session-persistence-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-MEMORY-V1
depends-on = NATIVE-INTERACTION-V1
depends-on = NATIVE-OUTPUT-V1
verified-by = NATIVE-SCREENREADER-V1 external NVDA witness
fresh-initial-role = exchange
fresh-action-rule = unique native inverse from current native state
fresh-result-role = identity
persistent-memory-carrier = one native LAB21 relation element
persistent-memory-semantics = native relation element only
resume-rule = restore exact persisted native relation element before human projection
resume-visible = Native state identity
resume-uia = Native state identity
resume-speech = Native state identity
resume-braille = Native state identity
input-carrier-a = UIA InvokePattern
input-carrier-b = keyboard Enter
restart-boundary = fresh writer process exits before independent resume process starts
carrier-specific-meaning = forbidden
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse screen-reader output when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux semantic replay of persisted bytes and traces
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = persistence-carrier-presentation-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future persistent human state must restore the same native meaning and equivalent nonvisual output after process restart without a separate accessibility reconstruction path
claim = success will establish accessible persistence across a real process-stop process-start boundary for both assistive invocation and keyboard-originated native state changes
claim = success will prove that the persisted byte is interpreted structurally from LAB21 rather than by host numeric label semantics
claim = success will not establish crash consistency power-loss durability encryption storage-device drivers filesystem independence or firmware persistence
