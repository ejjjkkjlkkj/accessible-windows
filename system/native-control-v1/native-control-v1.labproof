NATIVE-CONTROL-V1
role = system-owned-human-executive-control-gate-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-GOAL-V1
depends-on = NATIVE-GOAL-EXECUTION-V1
depends-on = NATIVE-INPUT-V1
depends-on = NATIVE-OUTPUT-V1
control-input = current native state plus human-selected native goal
human-decision-a = keep current native state
human-decision-b = apply selected native goal
decision-semantics = choose target relation from current state or supplied goal state
execution-rule = derive unique native action from current state to human-selected target then apply native composition
veto-rule = selecting current state as target structurally yields identity action and preserves current state
authorization-rule = selecting supplied goal as target derives the action required to reach that goal
autonomous-execution = false
human-authorization = required
boolean-control-semantics = none
external-score = none
external-ranking = none
decision-carrier-a = UIA InvokePattern
decision-carrier-b = keyboard Enter
required-output-carriers = visible UI UIA NVDA speech NVDA braille
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse human control witness when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
required-control-scenarios = 4
independent-observer = GitHub-hosted Linux structural replay
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = human-control-input-output-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future execution authorization veto pause resume cancellation recovery and confirmation must expose the same native control semantics nonvisually and remain fully operable without sight or pointer dependence
claim = success will establish a human-accessible structural veto and authorization gate immediately before native goal execution
claim = success will establish that keeping current state executes the structurally derived identity action rather than a host-language boolean bypass
claim = success will not establish physical emergency-stop hardware secure attention key firmware control or cancellation of already completed external-world actuation
claim = external runtimes screen readers APIs and operating systems remain carriers and witnesses rather than semantic foundations
