NATIVE-RESOURCE-V1
role = system-owned-native-relational-resource-ownership-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-LOCATION-V1
depends-on = NATIVE-STORE-V1
resource-location-key = exact width-8 native relational location key
resource-state = one native LAB21 relation element
available-role = structurally discovered identity relation
held-role = structurally discovered non-identity relation
claim-action = structurally discovered non-identity relation
release-action = structurally discovered non-identity relation
claim-rule = compose available role with claim action to reach held role
release-rule = compose held role with release action to return available role
concurrent-claim-rule = exactly one native available-to-held transition per target location
competing-claim-result = observation of already-held structural role without additional transition
required-locations = 256
required-contenders-per-location = 16
required-claim-transitions = 256
required-blocked-claim-observations = 3840
required-release-transitions = 256
required-final-available-locations = 256
target-selection-policy = not-established
priority-semantics = none
fairness-semantics = not-established
owner-identity-semantics = not-established
pointer-semantics = none
integer-address-semantics = none
external-carrier-slot = witness-only
external-concurrency-mechanism = Windows .NET Parallel Interlocked CompareExchange
external-concurrency-semantics = carrier-and-witness-only
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux structural replay
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing resource ownership allocation release contention priority inspection or recovery surface must expose the same structural resource roles nonvisually and remain fully operable without sight or pointer dependence
proof = PENDING
claim = success will establish native claim and release semantics over relationally identified resources without integer-address or pointer semantics
claim = success will establish exactly one available-to-held transition under sixteen concurrent external claim attempts for each of 256 relational locations and structural return to availability
claim = success will not establish target selection policy fairness owner identity priority preemption allocation size virtual memory or physical memory
