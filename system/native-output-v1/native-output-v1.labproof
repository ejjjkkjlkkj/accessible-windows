NATIVE-OUTPUT-V1
role = system-owned-multimodal-human-output-projection-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-INPUT-V1
verified-by = NATIVE-SCREENREADER-V1 external witness
native-semantic-source = structurally discovered LAB21 identity role
human-projection-rule = identity maps to Native state identity
required-output-carrier-visible = Windows Forms visible text witness
required-output-carrier-accessibility = UIA accessible name witness
required-output-carrier-speech = NVDA Controller Client speech witness
required-output-carrier-braille = NVDA Controller Client braille witness
single-semantic-message = Native state identity
carrier-specific-meaning = forbidden
secure-data = false
secure-screen-policy = refuse screen-reader output when Windows LogonUI indicates locked or secure screen
vision-required = false
speech-required-for-operation = false
braille-hardware-required-for-operation = false
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
screen-reader = NVDA external compatibility witness
independent-observer = GitHub-hosted Linux semantic replay
external-infrastructure = Windows Forms UIA NVDA Controller Client Windows AMD x86-64 Linux GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = presentation-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future human output channel must consume the same native semantic state and may transform presentation form but may not invent omit or contradict system meaning
claim = success will establish one native human semantic state projected equivalently through visual UI UIA NVDA speech and NVDA braille controller channels
claim = success will not prove physical acoustic capture or physical braille-cell movement
claim = Windows Forms UIA NVDA Windows and host runtimes remain external presentation and compatibility carriers rather than system semantic foundations
