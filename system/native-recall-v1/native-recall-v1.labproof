NATIVE-RECALL-V1
role = system-owned-accessible-episodic-recall-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-EPISODE-V1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-OUTPUT-V1
recall-source = persistent NATIVE-EPISODE-V1 history
recall-mode = read-only
navigation-carrier-a = UIA InvokePattern
navigation-carrier-b = keyboard Enter on focused Previous and Next controls
projection-rule = each recalled episode projects the same current goal target result semantics through all human output carriers
required-output-carriers = visible UI UIA NVDA speech NVDA braille
history-mutation = forbidden
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse recall witness when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
expected-episodes = 4
independent-observer = GitHub-hosted Linux semantic replay
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = recall-input-output-carrier-and-witness-only
proof = PENDING
accessibility-gate = any future episodic recall search filter timeline audit explanation retention deletion or export must expose the same native episode semantics nonvisually and remain fully operable without sight or pointer dependence
claim = success will establish read-only accessible navigation through persistent native episodic memory with equivalent visual UIA speech and braille projections
claim = success will establish keyboard and assistive navigation without requiring pointer use or vision
claim = success will not establish semantic natural-language summarization search indexing deletion privacy policy encryption or physical braille-cell verification
