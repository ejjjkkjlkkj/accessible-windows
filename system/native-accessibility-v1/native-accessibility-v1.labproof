NATIVE-ACCESSIBILITY-V1
role = first-human-facing-native-accessibility-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB24 native transition core v1
depends-on = NATIVE-SENSORY-CYCLE-V1
human-facing = true
human-state-source = structurally discovered LAB21 relation role
human-action-source = LAB24 native transition semantics
single-semantic-source = visible text accessible name keyboard action and assistive-technology action are projections of the same native structural state and action
initial-structural-role = exchange
target-structural-role = identity
visible-status = required
uia-accessible-name = required
uia-button-name = required
uia-invoke-pattern = required
keyboard-focus = required
keyboard-enter = required
state-change-notification = required
mouse-required = false
vision-required = false
separate-accessibility-reconstruction = forbidden
carrier-labels-human-facing = forbidden
target-real-runner = AMD-5800H-REAL
external-human-interface-witness = Windows Forms UIA MSAA keyboard
independent-observer = GitHub-hosted Linux semantic replay of emitted trace
external-infrastructure = Windows Forms UIA MSAA keyboard AMD x86-64 Linux GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = presentation-and-witness-only
proof = PENDING
accessibility-behavior = PENDING
accessibility-gate = any future visual control state message dialog notification menu input or error must be generated from the same native semantic source exposed nonvisually and remain fully operable without pointer or sight
claim = success will establish the first tested human-facing surface whose accessibility semantics are generated at the same source as its visible semantics
claim = success will prove UIA assistive-technology invocation and physical keyboard-style Enter activation both reach the same native action
claim = success will not make Windows Forms UIA MSAA .NET or Windows part of the system semantic foundation
claim = success will not yet prove NVDA JAWS braille speech touch camera or firmware accessibility behavior
