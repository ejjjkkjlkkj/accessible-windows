NATIVE-STORE-V1
role = system-owned-native-relational-store-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-LOCATION-V1
store-location-key = exact width-8 native relational location key
store-cell-state = one native LAB21 relation element
lookup-semantics = elementwise native location key equality
mutation-semantics = compose current cell state with a native LAB21 relation action
initial-state-rule = fold all relation elements of the location key from structural identity
mutation-action-rule = first relation element of the location key
required-locations = 256
required-initial-lookups = 256
required-mutations = 256
required-mutated-lookups = 256
pointer-semantics = none
integer-address-semantics = none
location-ordering-semantics = none
allocation-semantics = not-established
free-semantics = not-established
protection-semantics = not-established
persistence-semantics = not-established
external-record-order = carrier-only
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux structural replay
external-infrastructure = AMD x86-64 Windows Linux GitHub Actions PowerShell CSharp Python filesystem
external-infrastructure-semantics = carrier-and-witness-only
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing store memory allocation protection inspection recovery or debugging surface must expose relational location and cell state semantics nonvisually and remain fully operable without sight or pointer dependence
proof = PENDING
claim = success will establish a system-owned key-to-native-state store whose lookup depends on relational location identity rather than integer address or pointer semantics
claim = success will prove exhaustive unique lookup before and after one native mutation of every one of the 256 locations
claim = success will not establish allocation freeing protection paging virtual memory physical memory or persistence
