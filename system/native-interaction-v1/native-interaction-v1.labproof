NATIVE-INTERACTION-V1
role = integrated-human-input-native-action-human-output-cycle-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB24 native transition core v1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-INPUT-V1
depends-on = NATIVE-OUTPUT-V1
verified-by = NATIVE-SCREENREADER-V1 external NVDA witness
initial-native-role = exchange
target-native-role = identity
input-carrier-a = UIA InvokePattern
input-carrier-b = keyboard Enter
normalization-rule = each external carrier normalizes into the unique native inverse action from the current native state
native-action-role = exchange
output-visible = Native state identity
output-uia = Native state identity
output-speech = Native state identity
output-braille = Native state identity
single-semantic-source = structurally derived post-action native identity state
carrier-specific-meaning = forbidden
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse interaction witness when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux semantic replay
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = input-output-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future human interaction must preserve equivalent semantics from input normalization through native action through every output carrier without a separate accessibility reconstruction path
claim = success will establish one complete accessible human interaction loop from either assistive invocation or keyboard Enter into the same native action and the same visible UIA speech and braille semantic result
claim = success will not establish autonomous authority physical braille-cell movement acoustic speech capture camera touch switch gaze or firmware interaction
claim = external runtimes operating systems screen readers APIs and device abstractions remain carriers and witnesses rather than semantic foundations
