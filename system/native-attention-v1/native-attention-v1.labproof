NATIVE-ATTENTION-V1
role = system-owned-structural-novelty-attention-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB22 external AMD topology witness
depends-on = NATIVE-PERCEPTION-V1
depends-on = NATIVE-MEMORY-V1
attention-input = fresh NATIVE-PERCEPTION-V1 relation stream
attention-rule = select percept relations that are structurally different from the uniquely discovered LAB21 identity relation
ignored-rule = structural identity percepts are not selected
attention-output = ordered sequence of selected native LAB21 relation elements only
attention-score = none
external-priority = none
numeric-carrier-label-semantics = none
selection-position-metadata = witness-only
target-real-runner = AMD-5800H-REAL
expected-real-samples = 16
expected-real-focused = 7
expected-real-ignored = 9
independent-observer = GitHub-hosted Linux
external-infrastructure = AMD x86-64 CPUID Windows affinity Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = sensor-carrier-and-witness-only
proof = PENDING
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing attention focus notification prioritization or interruption must expose the same native structural selection nonvisually and remain operable without sight or pointer dependence
claim = success will establish a native structural novelty filter over real AMD-derived percepts without host-defined numeric attention scores
claim = success will not establish learned salience user intent task importance emotion semantic language understanding or autonomous priority
claim = external CPU topology and host runtimes remain stimulus carriers and witnesses rather than semantic foundations
