NATIVE-METACOGNITION-V1
role = system-owned-structural-self-monitoring-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-EPISODE-V1
metacognitive-input = episodic expected target and actual result native relation elements
discrepancy-rule = derive the unique native relation that transforms actual result into expected target
no-discrepancy = structurally discovered LAB21 identity relation
correction-required = structurally discovered LAB21 non-identity relation
metacognitive-output = ordered discrepancy relation stream one native relation per episode
boolean-error-semantics = none
external-score = none
external-threshold = none
numeric-carrier-label-semantics = none
positive-proof = valid episodic history produces only structural identity discrepancies
negative-proof = deliberately corrupted external witness copy produces a structural non-identity discrepancy
source-history-mutation = forbidden
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux structural replay
external-infrastructure = Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = carrier-and-witness-only
proof = PENDING
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing self-monitoring warning discrepancy explanation recovery or correction surface must expose the same native discrepancy semantics nonvisually and remain operable without sight or pointer dependence
claim = success will establish native self-monitoring as a structural relation between expected and actual outcome rather than a host boolean error flag
claim = success will prove both the no-discrepancy path and a negative mismatch-detection path while preserving the original valid episodic history
claim = success will not establish consciousness subjective awareness confidence calibration semantic introspection or autonomous recovery policy
