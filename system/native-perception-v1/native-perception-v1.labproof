NATIVE-PERCEPTION-V1
role = system-owned-native-perception-ingress-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = LAB22 external AMD topology witness
depends-on = LAB24 native transition core v1
depends-on = NATIVE-MEMORY-V1
depends-on = NATIVE-COGNITION-V1
depends-on = NATIVE-ACTION-V1
perception-boundary = external hardware samples are normalized into LAB21 structural relation elements before entering system-owned semantics
external-stimulus-v1 = sixteen real AMD logical-processor topology samples captured under explicit affinity
external-classifier-v1 = consecutive samples externally classified as same topology group or changed topology group
native-normalization-v1 = same external group maps to structurally discovered identity relation and changed external group maps to the other LAB21 relation
native-percept-stream = ordered sequence of LAB21 relation elements only
carrier-label-semantics = none
external-topology-semantics = boundary-only
truth-semantics = none
boolean-semantics = none
integer-semantics = none
target-real-runner = AMD-5800H-REAL
expected-external-samples = 16
independent-observer = GitHub-hosted Linux
cross-os-boundary = Linux independently replays the exact AMD stimulus capture through the same boundary rule and verifies the emitted native percept stream
external-infrastructure = AMD x86-64 CPUID Windows affinity Linux GitHub Actions PowerShell CSharp Python .NET filesystem
external-infrastructure-semantics = sensor-carrier-and-witness-only
proof = PENDING
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing sensory state alert focus description navigation or control must expose equivalent native semantics without requiring vision and must remain operable through nonvisual input at the same native layer
claim = perception v1 establishes a real external-to-native ingress boundary on the physical AMD carrier
claim = once normalized the system consumes only native relational percepts and does not assign semantic authority to CPUID Windows processor numbering or host-language values
claim = this proof does not yet establish camera audio microphone touch chemical environmental or human-language interpretation
