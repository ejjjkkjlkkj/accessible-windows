NATIVE-GOAL-V1
role = system-owned-human-selected-native-goal-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-INPUT-V1
depends-on = NATIVE-OUTPUT-V1
depends-on = NATIVE-SESSION-V1
goal-domain = the two structurally discovered LAB21 relation elements
goal-selection-carrier-a = UIA InvokePattern
goal-selection-carrier-b = keyboard Enter
goal-persistence = one native LAB21 relation element
goal-semantic-authority = selected native relation element only
goal-human-projection-identity = Native goal identity
goal-human-projection-exchange = Native goal exchange
required-output-carriers = visible UI UIA NVDA speech NVDA braille
external-choice-ranking = none
external-score = none
autonomous-goal-selection = false
human-authority = required
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse human goal witness when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
independent-observer = GitHub-hosted Linux semantic replay
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = human-input-output-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future goal choice confirmation cancellation modification and consequence must expose the same native goal semantics nonvisually and remain fully operable without sight or pointer dependence
claim = success will establish explicit human authority to select and persist either structural native goal through accessible input
claim = success will not establish autonomous goal generation preference inference optimization planning toward arbitrary semantic tasks or user-intent language understanding
claim = external runtimes screen readers APIs and operating systems remain carriers and witnesses rather than semantic foundations
