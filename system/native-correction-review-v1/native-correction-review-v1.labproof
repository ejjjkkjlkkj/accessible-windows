NATIVE-CORRECTION-REVIEW-V1
role = system-owned-accessible-human-correction-review-foundation-v1
system-foundation = true
depends-on = LAB21 native relational core v1
depends-on = NATIVE-EPISODE-V1
depends-on = NATIVE-METACOGNITION-V1
depends-on = NATIVE-CORRECTION-PLAN-V1
depends-on = NATIVE-ACCESSIBILITY-V1
depends-on = NATIVE-OUTPUT-V1
review-source = one structurally derived non-identity correction proposal from isolated negative witness history
human-authority = required
approve-semantics = select proposed native correction action without execution
reject-semantics = select structurally discovered native identity action without execution
boolean-decision-semantics = none
execution = forbidden
executed-actions = 0
autonomous-correction-execution = false
history-mutation = forbidden
plan-mutation = forbidden
navigation-carrier-a = UIA InvokePattern
navigation-carrier-b = physical-keyboard-equivalent A or R key event
required-output-carriers = visible UI UIA NVDA speech NVDA braille
pointer-required = false
vision-required = false
secure-data = false
secure-screen-policy = refuse correction review witness when Windows LogonUI indicates a locked or secure screen
human-facing = true
accessibility-behavior = PENDING
target-real-runner = AMD-5800H-REAL
required-review-scenarios = 2
required-approve-scenarios = 1
required-reject-scenarios = 1
independent-observer = GitHub-hosted Linux structural replay
external-infrastructure = Windows Forms UIA keyboard NVDA Controller Client Windows AMD x86-64 Linux filesystem GitHub Actions PowerShell CSharp Python .NET
external-infrastructure-semantics = review-input-output-carrier-and-witness-only
proof = PENDING
accessibility-gate = every future correction proposal explanation approval rejection execution recovery undo or audit surface must expose the same native semantics nonvisually and remain fully operable without sight or pointer dependence
claim = success will establish accessible human approval and rejection of a structurally derived correction proposal without executing that proposal
claim = success will encode rejection as the native identity action rather than a host-language boolean cancel flag
claim = success will establish equivalent visual UIA speech and braille presentation of the proposal and the human decision
claim = success will not authorize or execute correction and will not establish autonomous recovery
