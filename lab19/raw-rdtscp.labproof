LAB19
role = external-raw-rdtscp-counter-witness-record
system-foundation = false
purpose = test direct raw RDTSCP observations on AMD-5800H-REAL without using a compiler or assembler to produce the tested instruction bytes
target-runner = AMD-5800H-REAL
parallel-worker-policy = one worker per reported logical processor
samples-per-worker = 250000
ordering-claim = per-worker-only
cross-worker-ordering-claim = none
time-unit-semantics = none
code-bytes = 17
code-sha256 = a11c5b2d56347072659406ba756714b2af33a9ac4d37536a86a0c1c8a6088a32
external-infrastructure = AMD x86-64 RDTSCP CPUID Windows virtual memory .NET delegate bridge scheduler PowerShell CSharp GitHub Actions runner
external-infrastructure-semantics = witness-only
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-rdtscp-supported = UNPROVEN
proof-raw-rdtscp = UNPROVEN
proof-per-worker-nondecreasing = UNPROVEN
proof-per-worker-advance = UNPROVEN
proof-aux-observation = UNPROVEN
proof-accessibility-boundary = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove only that the tested raw RDTSCP observations did not move backward per worker and did advance during the real AMD run
claim = success would not establish a system-owned clock duration frequency scheduler timeout deadline cross-core order or time semantics
claim = x86-64 RDTSCP CPUID Windows .NET PowerShell CSharp GitHub Actions and AMD remain external witnesses only
