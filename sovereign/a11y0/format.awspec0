AW0SPEC0
kind = accessibility-proof-format
identity = A11Y0
status = SPECIFICATION-V0

::record
fields = path | class | A | B | invariant
class = interactive | noninteractive
A = PASS | UNPROVEN | FAIL
B = PASS | UNPROVEN | FAIL
default = none
::end

::invariant
id = A11Y0.FOUNDATION.NO-HUMAN-PATH-WITHOUT-SEMANTICS
interactive = semantic-source + keyboard + native-nonvisual-path
noninteractive = structured-state-errors + no-hidden-visual-human-state
omission = forbidden
::end

::release
rule = Every active sovereign artifact has exactly one record.
rule = Required release properties are PASS+PASS.
rule = Missing evidence is UNPROVEN.
::end
