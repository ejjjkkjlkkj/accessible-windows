AW0SRC00
cell AwSeed0 {
    identity tool.awseed0
    generation system.current

    authority {
        require seed.read
        require proof.read
        require stage.emit
        deny kernel.authority
        deny genome.mutate
        deny capability.mint
    }

    memory {
        keep status : trusted<semantic.record>
        shed workspace : own<bytes[65536]>
    }

    human {
        semantic tool.awseed0
        path keyboard | speech | braille
    }

    proof accessibility {
        invariant A11Y0.FOUNDATION.NO-HUMAN-PATH-WITHOUT-SEMANTICS
        evidence A structural
        evidence B required
    }

    flow advance(input : untrusted<seed.image>) -> trusted<stage.record> {
        effects validate(input) | use(proof.read) | use(stage.emit)
        body verify_seed_then_emit_stage(input)
    }
}
