QEVARYNOX_SRC_0
cell QevarynoxSeedTool0 {
    identity tool.qevseed0
    generation system.current

    authority {
        require seed.read
        require proof.read
        require stage.emit
        deny kernel.authority
        deny genome.mutate
        deny capability.mint
        deny security.floor.lower
        deny accessibility.disable
    }

    memory {
        keep status : trusted<semantic.record>
        shed workspace : own<bytes[65536]>
    }

    human {
        semantic tool.qevseed0
        path keyboard | speech | braille
    }

    proof accessibility {
        invariant QEVARYNOX.ACCESS.FOUNDATION.NO-HUMAN-PATH-WITHOUT-SEMANTICS
        evidence A structural
        evidence B required
    }

    proof origin {
        evidence D repository-origin
        external-source none
    }

    flow advance(input : untrusted<seed.image>) -> trusted<stage.record> {
        effects validate(input)
        body qevarynox_verify_seed_then_emit_stage(input)
    }
}
