QEVARYNOX_SRC_0
cell QevarynoxOriginCell0 {
    identity semantic.qevarynox.origin.probe
    generation system.current

    authority {
        require semantic.emit
        deny kernel.authority
        deny genome.mutate
        deny capability.mint
        deny security.floor.lower
        deny accessibility.disable
    }

    memory {
        keep result : trusted<semantic.record>
        shed scratch : own<bytes[4096]>
    }

    human {
        semantic qevarynox.origin.probe
        path keyboard | speech | braille
    }

    proof accessibility {
        invariant QEVARYNOX.ACCESS.FOUNDATION.NO-HUMAN-PATH-WITHOUT-SEMANTICS
        evidence A structural
        evidence B required
    }

    proof origin {
        evidence D repository-origin
        external-source none
    }

    flow inspect(input : untrusted<bytes>) -> trusted<semantic.record> {
        effects validate(input) | use(semantic.emit)
        body qevarynox_validate_then_emit(input)
    }
}
