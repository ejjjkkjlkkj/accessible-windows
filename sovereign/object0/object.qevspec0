QEVARYNOX_SPEC_0
kind = object-format
identity = QEVARYNOX-OBJECT-G0
generation = 0
status = EMITTER-LOADER-UNPROVEN

::header
magic = QEVARYNOX_OBJECT_0
byte-order = little-endian
version = 0
field = header-size:u32
field = target-isa-id:u32
field = section-count:u32
field = semantic-manifest-offset:u64
field = provenance-manifest-offset:u64
field = proof-manifest-offset:u64
field = flags:u64=0
::end

::sections
required = CODE
required = DATA
required = CELL
required = SEMANTIC
required = PROVENANCE
required = AUTHORITY
required = ACCESS
required = PROOF
::end

::authority
rule = section-existence-grants-no-authority
