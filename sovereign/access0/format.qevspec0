QEVARYNOX_SPEC_0
kind = accessibility-proof-format
identity = QEVARYNOX-ACCESS-G0
status = SPECIFICATION-V2

::record
fields = path | class | A | B | invariant
class = interactive | noninteractive
A = PASS | UNPROVEN | FAIL
B = PASS | UNPROVEN | FAIL
default = none
::end

::invariant
id = QEVARYNOX.ACCESS.FOUNDATION.NO-HUMAN-PATH-WITHOUT-SEMANTICS
interactive = semantic-source + keyboard + native-nonvisual-path
noninteractive = structured-state-errors + no-hidden-visual-human-state
omission = forbidden
::end

::truth
rule = file-presence-is-not-accessibility-B
rule = hash-equality-is-not-accessibility-B
rule = cross-host-byte-identity-is-not-accessibility-B
rule = B-PASS-requires-independent-behavioral-witness
rule = no-proof-means-UNPROVEN
::end

::release
rule = Every active sovereign artifact has exactly one record.
rule = Required release properties are PASS+PASS.
rule = Missing evidence is UNPROVEN.
::end
