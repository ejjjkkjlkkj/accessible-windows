OS-UEFI-HII-CURRENT-OPTION-SPEECH-BRIDGE-V1
role = revision-bound native pre-OS speech bridge from the proven current HII option text to a target-gated live HII option label over first-party HDA speech
system-foundation = true
depends-on = OS-UEFI-HII-CURRENT-OPTION-V1
depends-on = OS-UEFI-HDA-TEXT26-V1
execution-domain = pre-OS UEFI validation bridge
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-audio-driver-required = false
AudioDxe-required = false
current-option-source = OS-UEFI-HII-CURRENT-OPTION-V1 proof-current-option-text
target-prefix = normalized first eight Latin letters of the proven current option text
speech-source = live read-only HII EFI_IFR_ONE_OF_OPTION text resolved by native direct Strings-package decoder
speech-gate = HDA setup and DMA speech are unreachable until live option text prefix exactly matches target-prefix
speech-model = first-party deterministic letter-name allophone table
runtime-allophone-scheduling = native HDA Buffer Descriptor List
codec-vendor-hardcode = false
widget-nids-hardcoded = false
firmware-setting-mutation = forbidden
same-firmware-execution-current-read-and-speech = false
same-one-of-structural-identity-at-speech = not-established-in-this-stage
keyboard-navigation = not-established
physical-ASUS-current-option-speech = not-established
claim = success establishes that the text proven as the current HII option drives a strict target gate and that a live HII option label with that exact normalized prefix reaches native first-party HDA speech
claim = success does not establish that current-value resolution and speech occur in one EFI execution or that the spoken matching label is structurally the exact same ONE_OF_OPTION instance; those remain the next integration gate
proof = PENDING_DEPENDENCY
