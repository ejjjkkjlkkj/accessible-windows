OS-UEFI-HII-PLATFORM-COMMIT-V1
role = native pre-OS accessible HII selection commit on a genuinely persistent OVMF PlatformDxe Buffer Storage question
system-foundation = true
depends-on = OS-UEFI-HII-VARSTORE-DEF-V1
depends-on = OS-UEFI-HII-CURRENT-OPTION-SPEECH-V1
depends-on = OS-UEFI-HII-DOWN-SPEECH-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
target-driver = OvmfPkg/PlatformDxe
target-question = Change Preferred Resolution for Next Boot
target-question-id = 2
target-varstore-id = 1
target-varstore-offset = 32
target-varstore-size = 36
target-varstore-opcode = 0x24 EFI_IFR_VARSTORE
target-source-proof = OS-UEFI-HII-VARSTORE-DEF-V1
target-write-semantics = PlatformDxe RouteConfig -> ConfigToBlock -> FormStateToPlatformConfig -> PlatformConfigSave
navigation = DOWN moves focus to the next direct ONE_OF_OPTION in the exact live question
speech-source = live focused HII option label with ASCII digits and Latin a-z spoken by first-party allophone units
commit-key = Enter
pre-enter-write = forbidden
commit-conversion = EFI_HII_CONFIG_ROUTING_PROTOCOL.BlockToConfig
commit-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.RouteConfig
post-commit-validation = fresh isolated OVMF boot with the exact same workflow-owned VARS image
qemu-setting-mutation = allowed only inside workflow-owned copied OVMF VARS
physical-host-reboot = forbidden
physical-host-boot-order-write = forbidden
physical-host-secure-boot-write = forbidden
physical-host-uefi-variable-write = forbidden
physical-ASUS-platform-commit = not-established
claim = success establishes native HII discovery, audible focus navigation, explicit Enter-gated persistent configuration mutation, audible confirmation, and persistence on a fresh isolated OVMF boot
claim = this replaces the EDK II iSCSI static Enabled field as the writable oracle because the iSCSI field is not independently persistent without attempt context
proof = PENDING_CI
