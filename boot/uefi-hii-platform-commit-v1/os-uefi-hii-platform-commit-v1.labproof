OS-UEFI-HII-PLATFORM-COMMIT-V1
role = native pre-OS accessible persistent HII commit against OVMF PlatformDxe
system-foundation = true
depends-on = OS-UEFI-HII-CURRENT-OPTION-SPEECH-V1
execution-domain = isolated QEMU OVMF pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
target-driver = OvmfPkg PlatformDxe
target-form-state = MainFormState
target-question = NextPreferredResolution
target-question-id = 2
target-varstore-id = 1
target-varstore-offset = 32
target-width-bytes = 4
target-storage = EFI HII Buffer Storage routed by PlatformDxe ConfigAccess
persistent-backend = PlatformConfig UEFI non-volatile variable
focus-key = SCAN_DOWN 0x0002
commit-key = Unicode carriage return 0x000D
focus-target-policy = next direct ONE_OF option
focus-speech-before-commit = required
commit-gate = explicit ENTER required after focused option speech
configuration-builder = EFI_HII_CONFIG_ROUTING_PROTOCOL.BlockToConfig
configuration-writer = EFI_HII_CONFIG_ROUTING_PROTOCOL.RouteConfig
persistence-verifier = reboot same workflow-owned copied OVMF VARS then read PlatformDxe HII current value
confirmation-speech-after-commit = required
qemu-setting-mutation = allowed only inside workflow-owned copied OVMF VARS
physical-host-reboot = forbidden
physical-host-boot-order-write = forbidden
physical-host-secure-boot-write = forbidden
physical-host-uefi-variable-write = forbidden
physical-ASUS-commit = forbidden-in-this-stage
claim = success proves DOWN focuses and speaks the next PlatformDxe resolution option, ENTER is required before RouteConfig, PlatformDxe persists the selected resolution through its non-volatile PlatformConfig backend, and a second boot using the exact same isolated VARS reads the committed option
claim = success does not authorize or establish mutation of the physical ASUS firmware
