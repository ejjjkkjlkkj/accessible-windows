OS-UEFI-HII-UP-SPEECH-V1
role = native pre-OS read-only UP-arrow focus traversal followed by speech of the newly focused direct HII option
system-foundation = true
depends-on = OS-UEFI-HII-CURRENT-OPTION-SPEECH-V1
depends-on = OS-UEFI-HII-ISCSI-FIXTURE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
keyboard-protocol = EFI_SIMPLE_TEXT_INPUT_PROTOCOL.ReadKeyStroke
keyboard-scan-code = SCAN_UP 0x0001
current-option-anchor = exact direct ONE_OF_OPTION matched to live current Buffer-Storage value
focus-rule = previous direct ONE_OF_OPTION sibling; first wraps to last direct sibling inside the exact same scoped ONE_OF
wrap-policy = first-direct-option wraps to last-direct-option
focus-label-source = focused sibling StringId resolved through the same live sibling HII Strings package and language namespace
focus-speech-source = normalized Latin graphemes captured from the focused sibling live HII label
speech-synthesizer = first-party deterministic allophones
audio-transport = native Intel HDA immediate verbs plus runtime BDL DMA
focus-operation = read-only
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
down-arrow-navigation = established-separately
physical-ASUS-up-focus-speech = not-established
claim = success establishes that UP moves accessibility focus to the previous direct ONE_OF_OPTION sibling using first-to-last wrap, resolves that sibling live HII label, and speaks that focused label over native HDA while leaving the firmware current value unchanged
claim = success does not establish physical ASUS keyboard/audio behavior
