OS-UEFI-HII-REPEAT-CURRENT-V1
role = native pre-OS accessibility repeat command that gates current live HII option speech on an explicit keyboard R/r event
system-foundation = true
depends-on = OS-UEFI-HII-CURRENT-OPTION-SPEECH-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
keyboard-protocol = EFI_SIMPLE_TEXT_INPUT_PROTOCOL.ReadKeyStroke
keyboard-interface-storage = bridge-owned persistent data pointer
keyboard-command = Unicode R or r
keyboard-effect = authorize repeat speech of the already resolved current option
keyboard-setting-mutation = false
current-selection-source = same-execution live Buffer-Storage ONE_OF current value
current-label-source = same-execution matching direct EFI_IFR_ONE_OF_OPTION StringId and live HII Strings package
speech-source = normalized Latin graphemes captured from that current option label
speech-synthesizer = first-party deterministic allophones
audio-transport = native Intel HDA immediate verbs plus runtime BDL DMA
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
arrow-navigation = not-established-in-this-stage
physical-ASUS-repeat-command = not-established
claim = success establishes that native pre-OS current-option speech remains blocked until a real EFI keyboard event carrying R/r is consumed by ReadKeyStroke and that the same execution then produces native HDA speech
claim = success does not establish Up/Down focus traversal or physical ASUS keyboard/audio behavior
proof = PENDING_CI
