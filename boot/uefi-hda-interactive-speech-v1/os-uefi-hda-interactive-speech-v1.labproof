OS-UEFI-HDA-INTERACTIVE-SPEECH-V1
role = native pre-OS keyboard-selected multi-word speech over runtime-discovered HDA output route v1
system-foundation = true
depends-on = OS-UEFI-HDA-WORD-SELECT-V1
depends-on = OS-UEFI-HDA-SPEECH-AUTOROUTE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
input-source = EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
runtime-word-options = AIDE,ERREUR
runtime-word-selection = required
runtime-allophone-scheduling = native HDA Buffer Descriptor List
full-utterance-pcm-assets = 0
recorded-human-speech-assets = false
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
dac-output-amp = programmed and read back at runtime
stream-route-dac-nid-source = runtime-discovered data
stream-route-pin-nid-source = runtime-discovered data
codec-command-transport = HDA Immediate Command PIO
stream-transport = native HDA stream descriptor DMA
stream-control = byte-safe SDCTL reset tag and RUN
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-micro
required-runtime-key-1-AIDE = true
required-runtime-key-2-ERREUR = true
required-runtime-AFG-discovery = true
required-runtime-widget-discovery = true
required-runtime-direct-route = true
required-runtime-output-policy = true
required-runtime-distinct-waveforms = true
interactive-native-HDA-speech = required
multi-hop-mixer-selector-routing = not-established
arbitrary-text-speech = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes keyboard-selected first-party speech over native HDA where DAC and output-pin NIDs are discovered at runtime and two different selected words produce distinct HDA waveforms
claim = success does not establish arbitrary-text TTS multi-hop codec routing physical ASUS output or Secure Boot
proof = PENDING_CI
