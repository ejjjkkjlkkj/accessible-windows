OS-UEFI-SCREENREADER-V1
role = native semantic UEFI screen reader core v1
system-foundation = true
depends-on = OS-UEFI-INTERACTIVE-ACCESS-V1
human-facing = true
execution-domain = pre-OS UEFI
screen-reader-core = native
external-screen-reader-required = false
nvda-required = false
jaws-required = false
windows-required = false
linux-required = false
visual-surface-required = false
pointer-required = false
keyboard-operable = true
semantic-source = same native UEFI state machine that owns focus selection status help error and recovery states
focus-model = explicit native focus object
announcement-model = state-change driven utterance queue
announcement-on-entry = current screen title current focused item position item label and status
announcement-on-focus-change = focused item label position and availability
announcement-on-activation = action confirmation result or blocking reason
announcement-on-invalid-key = invalid input reason and current focus preserved
announcement-on-recovery = recovery status reason and available next action
announcement-on-help = contextual keyboard and accessibility help
repeat-current = required
read-current-item = required
read-current-screen = required
next-item = required
previous-item = required
activate-item = required
escape-back = required
speech-interrupt = required
speech-queue = required
speech-rate-control = planned
speech-volume-control = planned
braille-model = planned
audio-speech-output = not-established
native-audio-driver = not-established
native-tts-engine = not-established
serial-semantic-witness = current test witness only
serial-is-product-speech = false
accessibility-reconstruction = forbidden
claim = this contract defines a true native screen-reader interaction core for UEFI whose semantic events originate from the same state machine as the firmware UI
claim = COM1 is only a deterministic witness until native audio and TTS are proven
claim = speech must not be marked PASS until synthesized audio is emitted through a system-owned audio path and independently captured or heard
proof = CONTRACT_ONLY
