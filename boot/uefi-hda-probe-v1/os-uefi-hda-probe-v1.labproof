OS-UEFI-HDA-PROBE-V1
role = native pre-OS High Definition Audio controller and codec presence probe v1
system-foundation = true
depends-on = OS-UEFI-SCREENREADER-INTERACTIVE-V1
depends-on = OS-UEFI-CONOUT-SCREENREADER-V2
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
external-audio-driver-required = false
AudioDxe-required = false
operating-system-required = false
windows-required = false
linux-required-at-runtime = false
pci-discovery = direct PCI configuration mechanism 1
pci-config-address-port = 0xCF8
pci-config-data-port = 0xCFC
pci-scan-scope = bus 0 all device-functions
pci-class = 0x04
pci-subclass = 0x03
pci-memory-space-enable = true
pci-bus-master-enable = true
controller-register-access = direct BAR0 MMIO
hda-gcap-offset = 0x00
hda-vmaj-offset = 0x03
hda-gctl-offset = 0x08
hda-statest-offset = 0x0E
controller-reset = clear GCTL.CRST then set GCTL.CRST with bounded polling
codec-detection = STATESTS nonzero after controller reset
serial-role = deterministic evidence only
serial-is-user-facing-audio = false
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-duplex
visual-surface-required = false
pointer-required = false
audio-playback = not-established
corb-rirb = not-established
codec-verbs = not-established
stream-descriptor-output = not-established
native-hda-speech = not-established
physical-ASUS-HDA = not-established
physical-ASUS-firmware-boot = not-established
secure-boot = not-established
claim = success proves direct firmware-owned discovery reset and codec-presence handling for an HDA controller without an operating-system audio stack or external UEFI audio driver
claim = success does not yet prove HDA PCM playback codec routing laptop speaker output or physical hardware compatibility
proof = PENDING_CI
