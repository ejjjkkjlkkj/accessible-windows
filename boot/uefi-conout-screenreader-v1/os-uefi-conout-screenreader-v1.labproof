OS-UEFI-CONOUT-SCREENREADER-V1
role = external UEFI text output interception to spoken accessibility bridge v1
system-foundation = true
depends-on = OS-UEFI-SCREENREADER-V2
human-facing = true
execution-domain = pre-OS UEFI
screen-reader-core = native
observed-interface = EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL.OutputString
system-table-conout-offset = 0x40
simple-text-output-outputstring-offset = 0x08
observer-model = temporary proxy of ConOut.OutputString while a separate embedded UEFI image executes
child-image-source = separate PE32+ EFI application embedded as LoadImage source buffer
child-text = Secure Boot desactive.
child-text-encoding = UTF-16LE
capture-source = actual CHAR16 pointer passed by child to ConOut.OutputString
speech-trigger = exact captured target text
speech-output = native pre-OS SB16 DMA audio path
COM1-role = evidence-only
original-outputstring-called = true
original-outputstring-restored = true
visual-surface-required = false
pointer-required = false
external-screen-reader-required = false
native-tts-engine = not-established
generic-arbitrary-text-speech = not-established
physical-HDA-driver = not-established
physical-ASUS-firmware-integration = not-established
accessibility-reconstruction = forbidden
proof = PENDING
claim = success establishes that text emitted by a second independently loaded UEFI application through the standard ConOut OutputString interface is intercepted by the native screen-reader bridge and causes spoken audio before the OS
claim = success does not establish arbitrary dynamic text-to-speech all OEM graphical firmware surfaces HII form semantics physical laptop audio or Secure Boot mutation
