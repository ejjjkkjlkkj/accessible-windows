OS-UEFI-HII-PROMPT-SPEECH-V1
role = native pre-OS live firmware HII prompt to first-party speech over runtime-discovered HDA
system-foundation = true
depends-on = OS-UEFI-HII-PROMPT-V1
depends-on = OS-UEFI-HDA-TEXT26-V1
