OS-UEFI-HII-PROMPT-SPEECH-V1
role = native pre-OS live firmware HII prompt to first-party speech over runtime-discovered HDA
system-foundation = true
depends-on = OS-UEFI-HII-PROMPT-V1
depends-on = OS-UEFI-HDA-TEXT26-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-audio-driver-required = false
AudioDxe-required = false
prompt-source = live read-only HII package export, IFR Prompt StringId plus native Strings-package decoder
prompt-source-hardcoded = false
prompt-string-protocol-required = false
prompt-package-search = all exported Forms-plus-Strings package lists
prompt-language-search = sibling EFI_HII_PACKAGE_STRINGS packages
spoken-character-filter = Latin a-z case-insensitive
maximum-spoken-prompt-graphemes = 8
speech-model = first-party deterministic letter-name allophone table
recorded-human-speech-assets = false
full-utterance-pcm-assets = 0
runtime-allophone-scheduling = native HDA Buffer Descriptor List
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
eapd-policy = enable and verify when advertised
keyboard-input-required = false
visual-surface-required = false
pointer-required = false
firmware-setting-mutation = forbidden
option-speech = not-established
current-value-speech = not-established
keyboard-navigation = not-established
physical-ASUS-HII-prompt-speech = not-established
claim = success establishes that a real prompt resolved from live firmware HII becomes the runtime source of first-party letter-name speech over dynamically discovered native HDA
claim = success does not establish option or current-value speech navigation configuration mutation or physical ASUS firmware output
proof = PENDING_CI
revalidation-request = 2026-09-18T22:04+02:00
