OS-UEFI-HII-TITLE-V1
role = native pre-OS IFR title StringId resolution through UEFI HII String protocol
system-foundation = true
depends-on = OS-UEFI-HII-PROBE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
hii-database-protocol = required
hii-string-protocol-guid = 0fd96974-23aa-4cdc-b9cb-98d17750322a
forms-handle-selection = EFI_HII_DATABASE_PROTOCOL ListPackageLists type 0x02
forms-package-export = selected HII handle
IFR-form-set-opcode = 0x0E
IFR-form-opcode = 0x01
IFR-title-token-source = FormSetTitle or FormTitle
language-selection = first RFC language returned by EFI_HII_STRING_PROTOCOL GetLanguages
title-resolution = EFI_HII_STRING_PROTOCOL GetString
title-output = serial ASCII projection of resolved UTF-16 title
firmware-setting-mutation = forbidden
question-prompt-resolution = not-established
option-resolution = not-established
speech-output = not-established-in-this-stage
physical-ASUS-HII = not-established
claim = success establishes that native pre-OS code selects a live Forms HII handle, extracts a real IFR title StringId, resolves it using the firmware HII String protocol and emits a non-empty human-readable title
claim = success does not establish question navigation setting mutation option semantics speech or physical ASUS firmware compatibility
proof = PENDING_CI
