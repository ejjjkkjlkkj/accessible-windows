OS-UEFI-HII-TITLE-V1
role = native pre-OS IFR title StringId resolution through direct read-only HII package export parsing
system-foundation = true
depends-on = OS-UEFI-HII-PROBE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
hii-database-protocol = required
hii-string-protocol = not-required-for-title-resolution
package-selection = ExportPackageLists NULL then select one exported package list containing both Forms and Strings packages
forms-package-source = global read-only HII database export
IFR-form-set-opcode = 0x0E
IFR-form-opcode = 0x01
IFR-title-token-source = FormSetTitle or FormTitle
language-selection = language metadata of selected EFI_HII_PACKAGE_STRINGS package
title-resolution = native direct EFI_HII string-block decoder keyed by IFR StringId
title-output = serial ASCII projection of resolved UTF-16 title
firmware-setting-mutation = forbidden
question-prompt-resolution = not-established
option-resolution = not-established
speech-output = not-established-in-this-stage
physical-ASUS-HII = not-established
claim = success establishes that native pre-OS code parses a live read-only HII database export, pairs Forms and Strings packages from one package list, extracts a real IFR title StringId, resolves it with its native string-block decoder and emits a non-empty human-readable title
