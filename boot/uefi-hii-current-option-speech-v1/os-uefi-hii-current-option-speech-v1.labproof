current-label-hardcoded = false
speech-source = normalized Latin graphemes captured directly from the resolved current option label
speech-max-graphemes = 8
speech-synthesizer = first-party allophone unit bank reused from OS-UEFI-HII-OPTION-SPEECH-V1
audio-transport = native Intel HDA immediate verbs plus runtime BDL DMA
hda-route = runtime codec Audio Function Group DAC and output-pin discovery; no fixed widget NIDs
waveform-proof = QEMU HDA WAV plus LPIB progress
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig plus ConfigToBlock
runtime-varstore-identity = same-execution VarStore id offset size and raw GUID must equal the independent EDK II iSCSI fixture oracle
