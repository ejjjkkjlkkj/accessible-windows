current-selection-source = same-execution Buffer-Storage ONE_OF current value matched to its direct EFI_IFR_ONE_OF_OPTION child
current-label-source = exact live HII Strings package and language that resolved the question
current-label-hardcoded = false
speech-source = normalized Latin graphemes captured directly from the resolved current option label
speech-max-graphemes = 8
speech-synthesizer = first-party allophone unit bank reused from OS-UEFI-HII-OPTION-SPEECH-V1
audio-transport = native Intel HDA immediate verbs plus runtime BDL DMA
hda-route = runtime codec Audio Function Group DAC and output-pin discovery; no fixed widget NIDs
waveform-proof = QEMU HDA WAV plus LPIB progress
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig plus ConfigToBlock
runtime-varstore-identity = same-execution VarStore id offset size and raw GUID must equal the independent EDK II iSCSI fixture oracle
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
physical-ASUS-current-option-speech = not-established
claim = success establishes that one native pre-OS UEFI execution reads the live current ONE_OF value, resolves the selected option text from live HII, derives the spoken graphemes from that text, and produces progressing native HDA DMA audio for those graphemes
claim = success does not establish physical ASUS M1603QA audio until the AMD-5800H-REAL gate executes on that machine
