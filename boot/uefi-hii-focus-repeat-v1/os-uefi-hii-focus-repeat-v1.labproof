OS-UEFI-HII-FOCUS-REPEAT-V1
role = native pre-OS two-key accessibility interaction: DOWN moves read-only focus to the next direct HII option, then R repeats and speaks that focused option
system-foundation = true
depends-on = OS-UEFI-HII-DOWN-SPEECH-V1
depends-on = OS-UEFI-HII-REPEAT-CURRENT-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
keyboard-protocol = EFI_SIMPLE_TEXT_INPUT_PROTOCOL.ReadKeyStroke
first-key = SCAN_DOWN 0x0002
second-key = Unicode R or r
initial-current-option = live Buffer-Storage ONE_OF current value
focus-rule = DOWN selects the first later direct ONE_OF_OPTION sibling in the exact same scoped ONE_OF
repeat-target = accessibility focus after DOWN, not the firmware current value
focus-label-source = focused sibling StringId resolved from the live sibling HII Strings package
speech-source = normalized Latin graphemes from the focused live HII label
speech-synthesizer = first-party deterministic allophones
audio-transport = native Intel HDA immediate verbs plus runtime BDL DMA
pre-repeat-audio = blocked until R or r is consumed
focus-operation = read-only
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
physical-ASUS-focus-repeat = not-established
claim = success establishes persistent accessibility focus across two separate EFI keyboard events: DOWN moves focus from the live current direct option to the next direct sibling, then R authorizes native HDA speech of that focused live label while the firmware current raw HII value remains unchanged
claim = success does not mutate the firmware setting and does not yet establish the same interaction on physical ASUS pre-OS hardware
