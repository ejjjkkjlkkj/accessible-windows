OS-UEFI-HII-BUFFER-CURRENT-V1
role = native pre-OS read-only current-value extraction for a live EFI_IFR_ONE_OF backed by EFI_IFR_VARSTORE Buffer Storage
system-foundation = true
depends-on = OS-UEFI-HII-VARSTORE-DEF-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
storage-opcode = 0x24 EFI_IFR_VARSTORE
storage-kind = Buffer Storage
storage-read-service = EFI_HII_CONFIG_ACCESS_PROTOCOL.ExtractConfig
extract-config-request = NULL to request all settings abstracted by the matched driver
package-driver-binding = ListPackageLists plus per-handle ExportPackageLists exact PackageListGuid and PackageLength match plus GetPackageListHandle
config-access-binding = BootServices.HandleProtocol on the matched DriverHandle with EFI_HII_CONFIG_ACCESS_PROTOCOL_GUID
binary-reconstruction = EFI_HII_CONFIG_ROUTING_PROTOCOL.ConfigToBlock
question-offset-source = EFI_IFR_QUESTION_HEADER.VarStoreInfo.VarOffset
question-width-source = EFI_IFR_ONE_OF.Flags and EFI_IFR_NUMERIC_SIZE mask 0x03
question-width-map = 0 to 1 byte, 1 to 2 bytes, 2 to 4 bytes, 3 to 8 bytes
read-buffer-limit = 65536 bytes
bounds-check = VarOffset plus question width must not exceed declared VarStore size or ConfigToBlock returned BlockSize
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
claim = success establishes the live current bytes of a Buffer-Storage-backed ONE_OF question by matching its HII package to the driver ConfigAccess interface, calling ExtractConfig read-only, reconstructing the block with ConfigToBlock, and selecting the field at VarOffset
claim = success does not call RouteConfig GetVariable SetVariable or modify any HII configuration firmware setting or option selection
proof = PENDING_CI
