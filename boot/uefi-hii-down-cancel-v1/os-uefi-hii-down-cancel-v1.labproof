OS-UEFI-HII-DOWN-CANCEL-V1
role = native pre-OS explicit ESC cancellation after read-only DOWN focus speech
system-foundation = true
depends-on = OS-UEFI-HII-DOWN-SPEECH-V1
execution-domain = isolated QEMU OVMF pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
focus-key = SCAN_DOWN 0x0002
cancel-key = native SCAN_ESC 0x0017 with Unicode ESC 0x001B fallback
initial-current-option = Disabled
initial-current-value = 0
focus-target-option = Enabled
focus-target-value = 1
focus-speech-before-cancel = required
cancel-gate = explicit ESC consumed after focused option speech
cancel-effect = return success without configuration routing
block-to-config-after-cancel = forbidden
route-config-after-cancel = forbidden
post-cancel-current-value = must remain 0
post-cancel-current-option = must remain Disabled
fresh-boot-verification = same copied OVMF VARS must remain Disabled 0
qemu-setting-mutation = forbidden
physical-host-reboot = forbidden
physical-host-uefi-variable-write = forbidden
physical-ASUS-cancel-flow = not-established
claim = success establishes that DOWN can move and speak accessibility focus, ESC can explicitly cancel, no HII write routing occurs, and the same isolated OVMF VARS remains Disabled 0 on a fresh boot
proof = PENDING_CI
