OS-UEFI-XHCI-DIRECT-STAGE3-V1
role = prove xHCI Address Device using custom Slot/EP0 contexts
target = OVMF + QEMU q35 + qemu-xhci + usb-audio
depends-on = OS-UEFI-XHCI-DIRECT-STAGE2-V1
required = Stage2 destructive controller takeover
required = zero scratchpad requirement for this gate
required = Input Control Context A0+A1
required = Slot Context speed/context-entries/root-hub-port
required = EP0 Control Endpoint Context with DCS=1
required = DCBAA slot pointer to Output Device Context
required = 10 ms reset recovery delay
required = Address Device command
required = Command Completion Success
required = nonzero xHCI-assigned USB device address
required = Slot State Addressed
claim = PASS proves custom xHCI device addressing under tested OVMF/QEMU configuration
claim = PASS does not yet submit EP0 GET_DESCRIPTOR transfer TRBs
claim = PASS does not yet configure USB Audio isochronous endpoint
claim = PASS does not yet transmit PCM
physical-hardware = not-established
proof = pending
