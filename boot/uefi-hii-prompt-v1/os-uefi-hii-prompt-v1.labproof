OS-UEFI-HII-PROMPT-V1
role = native pre-OS IFR statement and question Prompt StringId resolution through UEFI HII String protocol
system-foundation = true
depends-on = OS-UEFI-HII-TITLE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
forms-handle-selection = EFI_HII_DATABASE_PROTOCOL ListPackageLists type 0x02
IFR-statement-header = Prompt plus Help
prompt-token-offset = IFR opcode offset plus 2
supported-prompt-opcodes = Subtitle,Text,OneOf,Checkbox,Numeric,Password,Action,ResetButton,Ref,Date,Time,String,OrderedList
prompt-resolution = EFI_HII_STRING_PROTOCOL GetString
language-selection = first RFC language returned by GetLanguages
prompt-output = serial ASCII projection of resolved UTF-16 prompt
firmware-setting-mutation = forbidden
option-resolution = not-established
current-value-resolution = not-established
keyboard-navigation = not-established
speech-output = not-established-in-this-stage
physical-ASUS-HII = not-established
claim = success establishes native extraction and string resolution of a real nonzero IFR Prompt token from a live firmware Forms package
claim = success does not establish option values current values navigation mutation speech or physical ASUS firmware compatibility
proof = PENDING_CI
