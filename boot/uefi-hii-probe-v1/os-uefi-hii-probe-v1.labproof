OS-UEFI-HII-PROBE-V1
role = native pre-OS firmware Human Interface Infrastructure database discovery foundation
system-foundation = true
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
hii-database-protocol-guid = ef9fc172-a1b2-4693-b327-6d32fc416042
hii-database-resolution = EFI_BOOT_SERVICES LocateProtocol
hii-export-operation = EFI_HII_DATABASE_PROTOCOL ExportPackageLists
hii-export-scope = all package lists
package-list-header = EFI_HII_PACKAGE_LIST_HEADER
package-header = EFI_HII_PACKAGE_HEADER
forms-package-type = 0x02
strings-package-type = 0x04
end-package-type = 0xDF
required-package-list-nonzero = true
required-forms-package = true
required-strings-package = true
firmware-setup-string-decoding = not-established
IFR-form-opcode-decoding = not-established
firmware-setting-navigation = not-established
firmware-setting-mutation = forbidden-in-this-stage
speech-output = not-established-in-this-stage
visual-surface-required = false
pointer-required = false
claim = success establishes direct first-party access to the firmware HII database and proves exported firmware package lists contain both Forms and Strings package classes
claim = success does not establish string-token decoding IFR semantic navigation setting mutation or speech of firmware setup labels
proof = PENDING_CI
