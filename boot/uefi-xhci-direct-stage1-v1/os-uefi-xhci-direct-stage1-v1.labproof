OS-UEFI-XHCI-DIRECT-STAGE1-V1
role = prove direct xHCI PCI/MMIO discovery independently of EFI_USB_IO_PROTOCOL
mode = non-destructive
target = OVMF + QEMU q35 + qemu-xhci + usb-audio
required-pci-class = 0c:03:30
required = valid BAR0
required = xHCI capability register layout
required = nonzero MaxSlots
required = nonzero MaxPorts
required = operational/runtime register visibility
required = at least one connected root-hub port
collect = HCIVERSION
collect = HCSPARAMS1/2/3
collect = HCCPARAMS1
collect = DBOFF
collect = RTSOFF
collect = USBCMD
collect = USBSTS
collect = PAGESIZE
collect = CRCR
collect = DCBAAP
collect = CONFIG
collect = MFINDEX
collect = Supported Protocol extended capabilities
collect = PORTSC for connected ports
claim = PASS proves the application can independently locate and read the active xHCI controller via PCI and MMIO
claim = PASS does not reset or take destructive ownership of the controller
claim = PASS does not yet create command/event/transfer rings
claim = PASS does not yet stream USB Audio
proof = PASS
proof-run = 35596423730
proof-job = 106322173117
