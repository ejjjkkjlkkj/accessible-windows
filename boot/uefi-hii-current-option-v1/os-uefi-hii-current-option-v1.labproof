OS-UEFI-HII-CURRENT-OPTION-V1
role = integrated native pre-OS read-only resolution from a live Buffer-Storage ONE_OF question to the text of the currently selected direct EFI_IFR_ONE_OF_OPTION
system-foundation = true
depends-on = OS-UEFI-HII-SELECTED-OPTION-V1
depends-on = OS-UEFI-HII-ISCSI-FIXTURE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
option-opcode = 0x09 EFI_IFR_ONE_OF_OPTION
end-opcode = 0x29 EFI_IFR_END
storage-opcode = 0x24 EFI_IFR_VARSTORE
storage-kind = Buffer Storage
storage-read-service = EFI_HII_CONFIG_ROUTING_PROTOCOL.ExportConfig plus ConfigToBlock
question-text-source = live Strings package belonging to the same exported HII package-list as the Forms package
current-value-source = live read-only HII Config Routing ExportConfig plus ConfigToBlock
option-selection-source = direct child EFI_IFR_ONE_OF_OPTION whose numeric width and typed value equal the live current ONE_OF value
option-string-id-source = matching live EFI_IFR_ONE_OF_OPTION in that same Forms package
option-text-source = live Strings package belonging to the same HII package-list namespace as the matched Forms package
string-decoder = native direct EFI HII SCSU and UCS2 string-block decoder
scope-policy = scan only the scope opened by the exact live ONE_OF; nested scopes are tracked and excluded from direct-child selection
numeric-option-layout = fixed prefix 6 bytes plus typed Value width 1 2 4 or 8 bytes
numeric-option-lengths = 7 8 10 14 bytes for UINT8 UINT16 UINT32 UINT64
match-policy = direct option width must equal live current-value width and every typed value byte must match
integrated-output = QUESTION_TEXT plus current value metadata plus CURRENT_OPTION_TEXT and option metadata in one firmware execution
route-config-call = forbidden
runtime-variable-read = forbidden
set-variable-call = forbidden
varstore-write = forbidden
firmware-setting-mutation = forbidden
selected-option-speech = not-established-in-this-stage
claim = success establishes that one native pre-OS UEFI execution reads a live Buffer-Storage ONE_OF current value, binds it to the direct matching ONE_OF_OPTION, resolves that exact option StringId in the same HII package-list namespace, and emits the currently selected option text
claim = success does not establish audible speech of that current option; native speech remains a separate gate
proof = PENDING_CI
