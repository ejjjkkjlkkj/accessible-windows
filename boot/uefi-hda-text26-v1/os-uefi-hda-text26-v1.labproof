OS-UEFI-HDA-TEXT26-V1
role = native pre-OS multi-character Latin a-z text buffer to first-party letter-name allophones over runtime-discovered HDA
system-foundation = true
depends-on = OS-UEFI-HDA-TEXT-V1
depends-on = OS-UEFI-HDA-ALPHABET-SPEECH-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
input-source = EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
runtime-text-input = required
supported-runtime-graphemes = a-z
uppercase-normalization = ASCII uppercase to lowercase
text-commit-key = Enter
max-runtime-graphemes = 8
runtime-text-buffer = UTF-16
runtime-text-to-speech-map = 26-letter first-party letter-name allophone table
runtime-allophone-scheduling = one native HDA BDL entry per expanded allophone
maximum-letter-name-allophones = 7
maximum-runtime-bdl-entries = 56
full-utterance-pcm-assets = 0
recorded-human-speech-assets = false
external-tts-build-dependency = false
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
eapd-policy = enable and verify when advertised
stream-transport = native HDA stream descriptor DMA
required-runtime-text-zebra = true
required-runtime-text-mwx = true
required-runtime-distinct-waveforms = true
general-purpose-linguistic-G2P = not-established
spaces-punctuation-digits = not-established
multi-hop-mixer-selector-routing = not-established
physical-ASUS-HDA-speech = not-established
secure-boot-integration = OS-UEFI-SECURE-BOOT-V1
claim = success establishes buffered EFI runtime input across all Latin letters a-z and build-time expansion of each typed character into first-party letter-name allophones scheduled over native HDA DMA
claim = success does not establish linguistic word pronunciation spaces punctuation digits multi-hop physical ASUS speech
proof = PENDING_CI
