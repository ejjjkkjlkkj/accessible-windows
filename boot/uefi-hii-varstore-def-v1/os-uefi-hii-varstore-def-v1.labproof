OS-UEFI-HII-VARSTORE-DEF-V1
role = native pre-OS read-only resolution of the VarStore definition referenced by a live EFI_IFR_ONE_OF question
system-foundation = true
depends-on = OS-UEFI-HII-QUESTION-META-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-accessibility-api-required = false
question-opcode = 0x05 EFI_IFR_ONE_OF
question-selection = first resolvable ONE_OF with non-zero VarStoreId and a matching VarStore definition in the same Forms package
zero-varstore-id = skipped
supported-varstore-opcodes = 0x24 EFI_IFR_VARSTORE, 0x25 EFI_IFR_VARSTORE_NAME_VALUE, 0x26 EFI_IFR_VARSTORE_EFI
buffer-varstore-id-offset = opcode plus 18
buffer-varstore-guid-offset = opcode plus 2
buffer-varstore-size-offset = opcode plus 20
name-value-varstore-id-offset = opcode plus 2
name-value-varstore-guid-offset = opcode plus 4
efi-varstore-id-offset = opcode plus 2
efi-varstore-guid-offset = opcode plus 4
efi-varstore-attributes-offset = opcode plus 20
efi-varstore-size-offset = opcode plus 24
definition-match = exact 16-bit VarStoreId equality inside the same live HII Forms package
guid-output = raw 16 bytes in firmware encoding
current-value-read = forbidden-in-this-stage
runtime-variable-read = forbidden-in-this-stage
varstore-write = forbidden
firmware-setting-mutation = forbidden
claim = success establishes a storage-backed live ONE_OF question and the exact 0x24 0x25 or 0x26 VarStore definition referenced by its non-zero VarStoreId
claim = success does not establish current selected value variable contents routing semantics or any configuration mutation
proof = PENDING_CI
