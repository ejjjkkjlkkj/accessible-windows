OS-UEFI-HII-SPEECH-V1
role = native pre-OS firmware HII title to first-party speech over runtime-discovered HDA
system-foundation = true
depends-on = OS-UEFI-HII-TITLE-V1
depends-on = OS-UEFI-HDA-TEXT26-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-audio-driver-required = false
AudioDxe-required = false
title-source = live EFI HII Forms package StringId resolved through EFI_HII_STRING_PROTOCOL
title-source-hardcoded = false
spoken-character-filter = Latin a-z case-insensitive
maximum-spoken-title-graphemes = 8
speech-model = first-party deterministic letter-name allophone table
recorded-human-speech-assets = false
full-utterance-pcm-assets = 0
runtime-allophone-scheduling = native HDA Buffer Descriptor List
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
eapd-policy = enable and verify when advertised
keyboard-input-required = false
visual-surface-required = false
pointer-required = false
firmware-setting-mutation = forbidden
question-prompt-speech = not-established
option-speech = not-established
keyboard-navigation = not-established
physical-ASUS-HII-speech = not-established
claim = success establishes that a title resolved from the live firmware HII database becomes the runtime source of first-party letter-name speech over dynamically discovered native HDA with no hardcoded title and no keyboard injection
claim = success does not establish question or option speech navigation configuration mutation or physical ASUS firmware output
proof = PENDING_CI
