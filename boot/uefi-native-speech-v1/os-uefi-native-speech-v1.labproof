OS-UEFI-NATIVE-SPEECH-V1
role = first-party native pre-OS speech synthesis engine v1
system-foundation = true
depends-on = OS-UEFI-SCREENREADER-INTERACTIVE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
screen-reader-core = native
input-source = UEFI EFI_SIMPLE_TEXT_INPUT_PROTOCOL ReadKeyStroke
speech-engine = limited-lexicon concatenative allophone synthesizer
speech-unit-generation = first-party deterministic mathematical signal synthesis
speech-unit-generation-runtime = build-time
speech-utterance-composition = native EFI runtime
full-utterance-pcm-assets = forbidden
recorded-human-speech-assets = false
external-tts-build-dependency = false
espeak-required = false
ffmpeg-required = false
network-required-to-build-speech = false
audio-output = direct Sound Blaster 16 DSP plus ISA DMA witness
audio-format = unsigned 8-bit mono 8000 Hz
serial-role = deterministic evidence only
serial-is-user-facing-speech = false
visual-surface-required = false
pointer-required = false
windows-required-at-runtime = false
linux-required-at-runtime = false
nvda-required = false
jaws-required = false
general-purpose-grapheme-to-phoneme = not-established
arbitrary-text-speech = not-established
physical-hda = not-established
physical-asus-firmware-boot = not-established
secure-boot-mutation = not-established
braille-output = not-established
claim = this stage removes eSpeak ffmpeg and prerecorded full-utterance PCM from the UEFI speech build
claim = EFI machine code chooses and concatenates first-party speech units at runtime from the same focus and activation state machine
claim = PASS does not claim general arbitrary-text TTS or physical AMD HDA output
proof = PENDING_CI
