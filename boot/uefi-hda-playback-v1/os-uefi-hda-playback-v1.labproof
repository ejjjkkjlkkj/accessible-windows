OS-UEFI-HDA-PLAYBACK-V1
role = native pre-OS HDA PCM DMA playback engine v1
system-foundation = true
depends-on = OS-UEFI-HDA-PROBE-V1
depends-on = OS-UEFI-HDA-VERB-V1
depends-on = OS-UEFI-HDA-WIDGET-V1
depends-on = OS-UEFI-HDA-PCM-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
external-audio-driver-required = false
AudioDxe-required = false
operating-system-required = false
pci-discovery = direct PCI configuration mechanism 1
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
controller-register-access = direct BAR0 MMIO
codec-command-transport = HDA Immediate Command PIO
dma-allocation = UEFI AllocatePages below 4GiB
bdl = native HDA Buffer Descriptor List
bdl-entry-count = 1
bdl-ioc = true
pcm-origin = first-party deterministic mathematical tone
pcm-format = signed 16-bit little-endian stereo
pcm-rate = 48000
pcm-duration-ms = 320
output-stream-selection = first output stream after GCAP.ISS input streams
stream-id = 1
stream-format = HDA 48kHz 16-bit stereo 0x0011
stream-run = native SDnCTL RUN bit
stream-progress-proof = SDnLPIB nonzero after RUN
codec-dac-node-qemu = 2
codec-pin-node-qemu = 3
codec-dac-stream-verb = SET_CHANNEL_STREAMID
codec-dac-format-verb = SET_STREAM_FORMAT
codec-pin-output-verb = SET_PIN_WIDGET_CONTROL
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-duplex
serial-role = deterministic evidence only
visual-surface-required = false
pointer-required = false
audio-waveform-capture = required
native-hda-pcm-playback = required
native-hda-speech = not-established
general-codec-topology-routing = not-established
physical-ASUS-HDA-playback = not-established
physical-ASUS-firmware-boot = not-established
secure-boot = not-established
claim = success requires firmware-owned HDA stream DMA to advance LPIB and a non-silent waveform to be captured from the HDA codec backend
claim = success proves native HDA PCM playback on the QEMU HDA witness without an OS audio stack or external UEFI audio driver
claim = success does not yet establish physical ASUS speaker routing or native HDA speech
proof = PENDING_CI
