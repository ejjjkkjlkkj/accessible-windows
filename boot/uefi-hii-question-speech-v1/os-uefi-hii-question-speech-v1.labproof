OS-UEFI-HII-QUESTION-SPEECH-V1
role = native pre-OS live storage-backed HII ONE_OF question prompt to first-party speech over runtime-discovered HDA
system-foundation = true
depends-on = OS-UEFI-HII-STORED-QUESTION-V1
depends-on = OS-UEFI-HDA-TEXT26-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-screen-reader-required = false
external-audio-driver-required = false
AudioDxe-required = false
question-source = live read-only HII package export, EFI_IFR_ONE_OF Prompt StringId plus native Strings-package decoder
question-selection-policy = first resolvable EFI_IFR_ONE_OF with nonzero VarStoreId
question-source-hardcoded = false
question-string-protocol-required = false
question-package-export = atomic global HII database snapshot
question-direct-string-decoder = SCSU/UCS2 plus skip duplicate extension traversal
spoken-character-filter = Latin a-z case-insensitive
maximum-spoken-question-graphemes = 8
speech-model = first-party deterministic letter-name allophone table
recorded-human-speech-assets = false
full-utterance-pcm-assets = 0
runtime-allophone-scheduling = native HDA Buffer Descriptor List
codec-vendor-hardcode = false
widget-nids-hardcoded = false
audio-function-group = discovered at runtime
audio-output-converter = discovered at runtime
output-pin = discovered at runtime
direct-route = discovered at runtime
pin-config-default = queried at runtime
eapd-policy = enable and verify when advertised
keyboard-input-required = false
visual-surface-required = false
pointer-required = false
current-value-speech = not-established
option-label-speech = not-established
multi-hop-routing-in-this-stage = not-established
physical-ASUS-HII-question-speech = not-established
firmware-setting-mutation = forbidden
claim = success establishes that a live storage-backed EFI_IFR_ONE_OF prompt resolved from firmware HII becomes the runtime source of first-party speech over native HDA with no hardcoded question text and no keyboard injection
claim = success does not establish current selected value speech option-label speech configuration mutation multi-hop integration in this stage or physical ASUS firmware output
proof = PENDING_CI
