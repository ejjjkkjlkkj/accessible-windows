OS-UEFI-SCREENREADER-V2
role = interactive spoken pre-OS screen reader v2
system-foundation = true
depends-on = OS-UEFI-SCREENREADER-V1
depends-on = OS-UEFI-INTERACTIVE-ACCESS-V1
human-facing = true
execution-domain = pre-OS UEFI
screen-reader-core = native
speech-output = native pre-OS audio path
keyboard-input = UEFI ConIn ReadKeyStroke
menu-on-entry = spoken
invalid-key = spoken then menu repeated
accessibility-help = spoken then menu repeated
recovery-status = spoken then menu repeated
continue-confirmation = spoken then return EFI_SUCCESS
visual-surface-required = false
pointer-required = false
external-screen-reader-required = false
nvda-required = false
jaws-required = false
windows-required = false
linux-required = false
COM1-role = evidence-only
speech-language = fr
speech-menu = Qevarynox UEFI. Un continuer. Deux aide. Trois récupération.
speech-help = Aide accessibilité.
speech-recovery = Récupération indisponible.
speech-invalid = Touche invalide.
speech-continue = Continuer.
audio-device-v2 = Sound Blaster 16 compatible witness
audio-programming = direct DSP plus ISA DMA
audio-rate = 8000
audio-format = unsigned 8-bit mono
audio-buffer = low-memory 64 KiB aligned DMA window
speech-asset-origin = temporary external build-time synthesized witness assets
native-tts-engine = not-established
physical-HDA-driver = not-established
physical-ASUS-firmware-integration = not-established
accessibility-reconstruction = forbidden
proof = PENDING
claim = success establishes a keyboard-driven UEFI screen reader loop whose own state changes cause real spoken announcements before the OS
claim = success requires actual injected UEFI keystrokes and a captured non-silent audio waveform covering help recovery invalid-key and continue paths
claim = native text-to-speech synthesis and physical AMD HDA output remain separate unproven gates
