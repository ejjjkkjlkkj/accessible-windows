OS-UEFI-HDA-VERB-V1
role = native pre-OS HDA codec verb transport and enumeration proof v1
system-foundation = true
depends-on = OS-UEFI-HDA-PROBE-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
external-audio-driver-required = false
AudioDxe-required = false
operating-system-required = false
controller-transport = direct BAR0 MMIO
codec-command-transport = HDA Immediate Command PIO
immediate-command-output-offset = 0x60
immediate-response-input-offset = 0x64
immediate-command-status-offset = 0x68
immediate-command-busy = ICIS bit 0
immediate-result-valid = ICIS bit 1
get-parameter-verb = 0xF00
vendor-id-parameter = 0x00
subordinate-node-count-parameter = 0x04
function-group-type-parameter = 0x05
codec-address-source = first set STATESTS codec-presence bit
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-duplex
qemu-codec-vendor = 0x1AF4
required-root-vendor-query = true
required-root-subordinate-node-query = true
required-audio-function-group-query = true
audio-function-group-type = 0x01
serial-role = deterministic evidence only
visual-surface-required = false
pointer-required = false
CORB-RIRB = not-established
widget-enumeration = not-established
codec-routing = not-established
stream-descriptor-output = not-established
audio-playback = not-established
native-hda-speech = not-established
physical-ASUS-HDA = not-established
claim = success establishes real codec command and response traffic issued by native pre-OS code through the HDA Immediate Command interface
claim = success establishes Vendor ID root-node topology and an Audio Function Group response on the QEMU HDA witness
claim = success does not yet establish CORB RIRB stream DMA PCM playback codec routing or physical laptop audio
proof = PENDING_CI
