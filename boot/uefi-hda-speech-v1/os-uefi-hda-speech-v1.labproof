OS-UEFI-HDA-SPEECH-V1
role = first-party native pre-OS synthesized speech over native HDA DMA v1
system-foundation = true
depends-on = OS-UEFI-NATIVE-SPEECH-V1
depends-on = OS-UEFI-HDA-PLAYBACK-V1
execution-domain = pre-OS UEFI
artifact-format = PE32+ EFI application
architecture = x86-64
operating-system-required = false
external-audio-driver-required = false
AudioDxe-required = false
speech-engine-source = OS-UEFI-NATIVE-SPEECH-V1 first-party deterministic allophone generator
speech-word = AIDE
speech-unit-sequence = e,d
recorded-human-speech-assets = false
external-tts-build-dependency = false
speech-source-format = unsigned 8-bit mono 8000 Hz
hda-pcm-format = signed 16-bit little-endian stereo 48000 Hz
speech-format-conversion = deterministic 6x sample-hold plus signed amplitude conversion
codec-command-transport = HDA Immediate Command PIO
stream-transport = native HDA stream descriptor DMA
dma-allocation = UEFI AllocatePages below 4GiB
bdl = native HDA Buffer Descriptor List
stream-id = 1
stream-format = HDA 48kHz 16-bit stereo 0x0011
stream-control = byte-safe SDCTL reset tag and RUN
pci-scan-scope = segment 0 all 65536 bus-device-function tuples
qemu-witness-machine = q35
qemu-witness-controller = ich9-intel-hda
qemu-witness-codec = hda-duplex
required-runtime-LPIB-progress = true
required-runtime-speech-waveform = true
serial-role = deterministic evidence only
visual-surface-required = false
pointer-required = false
fixed-utterance-HDA-speech = required
dynamic-runtime-allophone-scheduling-over-HDA = not-established
arbitrary-text-speech = not-established
general-codec-topology-routing = not-established
physical-ASUS-HDA-speech = not-established
secure-boot = not-established
claim = success establishes a first-party synthesized word produced from the native speech allophone source and transported by native pre-OS HDA DMA into a non-silent waveform witness
claim = success does not establish arbitrary-text TTS dynamic runtime allophone scheduling over HDA or physical ASUS speaker output
proof = PENDING_CI
