LAB18
role = external-raw-locked-atomic-instruction-witness-record
system-foundation = false
purpose = test raw x86-64 LOCK XADD and LOCK CMPXCHG behavior under real parallel execution on AMD-5800H-REAL without using a compiler or assembler to produce the tested instruction bytes
target-runner = AMD-5800H-REAL
parallel-worker-policy = one worker per reported logical processor
increments-per-worker = 100000
cas-rounds = 512
xadd-code-bytes = 12
xadd-code-sha256 = 2b0d6ebb2de117485ed02d8dc3f59a1eb944844721f6e0ca2ef37eb119cfa581
cas-code-bytes = 9
cas-code-sha256 = 7ba18e8f47c043338600423094c582078caebf65aaf6f75d15f3ff3a0918739f
external-infrastructure = AMD x86-64 instruction execution Windows virtual memory .NET delegate bridge scheduler PowerShell CSharp GitHub Actions runner
external-infrastructure-semantics = witness-only
proof = UNPROVEN
proof-run = none
proof-self-hosted = UNPROVEN
proof-runner-identity = UNPROVEN
proof-raw-lock-xadd = UNPROVEN
proof-xadd-unique-returns = UNPROVEN
proof-raw-lock-cmpxchg = UNPROVEN
proof-cas-exclusive-winner = UNPROVEN
proof-accessibility-boundary = UNPROVEN
human-facing = false
accessibility-behavior = not-applicable
accessibility-gate = any future human-facing state must be perceivable and operable without requiring vision at the same native layer
claim = success would prove only the tested external raw locked instruction behavior on the real AMD carrier
claim = success would not make x86-64 LOCK instructions Windows .NET PowerShell CSharp or AMD architecture part of the system foundation
claim = success would not establish system-owned synchronization scheduler thread process memory model instruction language or accessibility semantics
